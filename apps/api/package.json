{
  "name": "@kanjiscribe/api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
