#!/usr/bin/env bash
set -u

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

UNSTAGE=()
while IFS= read -r -d '' status && IFS= read -r -d '' path; do
  case "$status" in
    D*) ;;
    *) UNSTAGE+=("$path") ;;
  esac
done < <(git diff --cached --name-status -z -- .scratch/)

if [ "${#UNSTAGE[@]}" -gt 0 ]; then
  git reset -q -- "${UNSTAGE[@]}"
  printf 'warning: unstaged %s file(s) under .scratch/ to keep them out of this commit\n' "${#UNSTAGE[@]}" >&2
  printf '%s\n' "${UNSTAGE[@]}" | sed 's/^/  /' >&2
fi

exit 0
